{
  "name": "photo-portfolio",
  "version": "1.0.0",
  "description": "JRMGraphy \u2014 bilingual editorial photography portfolio built with Astro, GSAP and Netlify Forms.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "scripts": {
    "prepare:photos": "node scripts/generate-photos.mjs",
    "diff:log": "node --experimental-strip-types scripts/generateDiff.ts",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "python3 scripts/verify-build.py",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "prebuild": "node scripts/prepare-responsive.mjs",
    "predev": "node scripts/prepare-responsive.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "astro": "^7.3.4",
    "exifr": "^7.1.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "gsap": "^3.15.0"
  },
  "overrides": {
    "yaml": "^2.8.3"
  }
}
