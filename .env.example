# Instagram Graph API Credentials
# These are required to run `scripts/sync_ig_metrics.py`

# 1. Follow the steps in the provided implementation plan to get your App Token
# Ensure this is the Long-Lived token (60 days)
INSTAGRAM_ACCESS_TOKEN="your_long_lived_token_here"

# 2. Get your Business Account ID using the Graph API Explorer: `me/accounts?fields=instagram_business_account`
INSTAGRAM_BUSINESS_ACCOUNT_ID="your_instagram_business_account_id"
