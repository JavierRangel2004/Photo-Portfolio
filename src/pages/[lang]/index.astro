---
import { Image } from "astro:assets";
import authorPortrait from "../../assets/images/yo.jpg";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import EditorialHero from "../../components/EditorialHero.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import Arrow from "../../components/Arrow.astro";
import { verticals, words, contactLink, type Lang } from "../../lib/editorial";
export function getStaticPaths() {
  return ["es", "en"].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const items = verticals(lang);
---

<BaseLayout
  title={words(
    lang,
    "Fotografía con una mirada propia",
    "Photography with a point of view",
  )}
  pageType="home"
>
  <Header />
  <main id="main">
    <EditorialHero />
    <section class="selected-work" id="selected-work">
      <div class="section-heading">
        <h2>
          {words(
            lang,
            "No es solo cómo se ve.",
            "It’s more than how it looks.",
          )}
          <br />
          <em>
            {words(
              lang,
              "Es lo que te hace sentir.",
              "It’s how it makes you feel.",
            )}
          </em>
        </h2>
        <p>
          {words(
            lang,
            "Una selección de mi trabajo. Tres formas de contar lo que importa, desde el detalle más pequeño hasta la energía de un escenario.",
            "A selection of my work. Three ways to tell the stories that matter, from the smallest detail to the energy of a stage.",
          )}
        </p>
      </div>
      {items.map((v, i) => (
        <article class:list={["work-story", `work-story--${v.id}`]}>
          <div class="work-story-image" data-reveal-image>
            <EditorialImage
              photo={v.picks[i === 0 ? 1 : i === 1 ? 1 : 2]}
              alt={`${v.name} — Javier Rangel`}
              caption={v.name}
            />
          </div>
          <div class="work-story-copy">
            <h3>{v.title}</h3>
            <p>{v.description}</p>
            <p class="uses">{v.uses}</p>
            <div class="story-links">
              <a class="text-link" href={`/${lang}/gallery/${v.id}/`}>
                {words(lang, "Entrar a este universo", "Explore this world")}
                <Arrow />
              </a>
              <a
                class="quiet-link"
                href={contactLink(lang, v.inquiry)}
                data-analytics-label={`home_${v.id}_inquiry`}
              >
                {words(lang, "Quiero fotos así", "I want photos like these")}
              </a>
            </div>
          </div>
          <div class="story-detail">
            <EditorialImage
              photo={v.picks[i === 0 ? 2 : i === 1 ? 2 : 1]}
              alt={`${v.name} — ${words(lang, "detalle de la selección", "selected detail")}`}
              zoom={false}
            />
          </div>
        </article>
      ))}
    </section>
    <section class="author-note">
      <figure class="author-portrait">
        <Image
          src={authorPortrait}
          alt="Javier Rangel"
          widths={[320, 600]}
          sizes="(max-width: 760px) 45vw, 24vw"
          loading="lazy"
        />
        <figcaption>Javier Rangel · JRMGraphy</figcaption>
      </figure>
      <h2>
        {words(lang, "Soy Javier.", "I’m Javier.")}
        <br />
        {words(lang, "Me interesa lo que hace", "I’m drawn to what makes")}
        <br />
        <em>{words(lang, "único a lo que miro.", "the ordinary your own.")}</em>
      </h2>
      <div>
        <p>
          {words(
            lang,
            "Trabajo desde Ciudad de México. Observo, converso y dirijo para encontrar imágenes con intención: las que se sienten tuyas.",
            "Based in Mexico City. I observe, talk and direct to find images with intention — the ones that feel like you.",
          )}
        </p>
        <a href={`/${lang}/about/`} class="text-link">
          {words(lang, "Conoce mi mirada", "Get to know my eye")}
          <Arrow />
        </a>
      </div>
    </section>
    <section class="process-section">
      <h2>
        {words(lang, "De una idea", "From an idea")}
        <br />
        <em>{words(lang, "a tus imágenes.", "to your images.")}</em>
      </h2>
      <ol class="process-list">
        {[
          [
            words(lang, "Lo imaginamos", "We imagine it"),
            words(
              lang,
              "Me cuentas tu proyecto. Definimos el propósito, la locación y dónde van a vivir las fotos.",
              "Tell me about your project. We define its purpose, location and where the images will live.",
            ),
          ],
          [
            words(lang, "Lo hacemos", "We make it"),
            words(
              lang,
              "Construimos la sesión juntos. Yo me encargo de la mirada, la luz y la dirección.",
              "We build the session together. I take care of the eye, the light and the direction.",
            ),
          ],
          [
            words(lang, "Lo compartes", "You share it"),
            words(
              lang,
              "Selecciono y edito las imágenes para entregarte una serie coherente, pensada para tu proyecto.",
              "I select and edit the photographs into a coherent series, made for your project.",
            ),
          ],
        ].map(([title, body]) => (
          <li>
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))}
      </ol>
    </section>
    <ContactCTA />
  </main>
  <Footer />
</BaseLayout>
