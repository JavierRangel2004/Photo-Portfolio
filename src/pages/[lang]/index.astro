---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import FeaturedGallery from '../../components/FeaturedGallery.astro';
import ServiceBlocks from '../../components/ServiceBlocks.astro';
import TrustSignals from '../../components/TrustSignals.astro';
import StatementBlock from '../../components/StatementBlock.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Modal from '../../components/Modal.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homeDesc = lang === 'es'
  ? 'Javier Rangel (JRMGraphy) — fotografía para artistas, marcas personales y proyectos creativos en CDMX. Retratos, branding, gastronomía y cobertura de eventos con imágenes naturales, profesionales y listas para promoción.'
  : 'Javier Rangel (JRMGraphy) — photography for artists, personal brands, and creative projects in Mexico City. Portraits, branding, gastronomy, and event coverage built for press, social, and the web.';
---

<BaseLayout
  title={t('nav.home')}
  description={homeDesc}
  pageType="home"
>
  <Header />

  <main>
    <Hero />
    <ServiceBlocks />
    <FeaturedGallery />
    <TrustSignals />
    <StatementBlock />
    <ContactCTA />
  </main>

  <Footer />
  <Modal />
</BaseLayout>
