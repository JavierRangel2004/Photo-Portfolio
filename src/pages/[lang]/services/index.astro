---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import ContactCTA from "../../../components/ContactCTA.astro";
import EditorialImage from "../../../components/EditorialImage.astro";
import Arrow from "../../../components/Arrow.astro";
import {
  verticals,
  words,
  contactLink,
  type Lang,
} from "../../../lib/editorial";
export function getStaticPaths() {
  return ["es", "en"].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const items = verticals(lang);
---

<BaseLayout
  title={words(lang, "Servicios de fotografía", "Photography services")}
  pageType="service"
>
  <Header />
  <main id="main">
    <section class="page-intro">
      <h1>
        {words(lang, "Una idea tuya.", "Your idea.")}
        <br />
        <em>{words(lang, "Una mirada juntos.", "Our point of view.")}</em>
      </h1>
      <p>
        {words(
          lang,
          "La sesión empieza por lo que necesitas contar. Elige tu punto de partida; damos forma al resto en una conversación.",
          "Every session starts with what you need to say. Choose your starting point; we’ll shape the rest in a conversation.",
        )}
      </p>
    </section>
    <div class="service-index">
      {items.map((v) => (
        <a
          href={`#${v.id === "product" ? "gastronomy" : v.id === "portraits" ? "branding" : "events"}`}
        >
          {v.name}
          <Arrow />
        </a>
      ))}
    </div>
    {items.map((v) => (
      <section
        class="service-chapter"
        id={
          v.id === "product"
            ? "gastronomy"
            : v.id === "portraits"
              ? "branding"
              : "events"
        }
      >
        <EditorialImage photo={v.hero} alt={v.name} caption={v.name} />
        <div>
          <h2>{v.title}</h2>
          <p>{v.description}</p>
          <h3>{words(lang, "Pensado para", "Made for")}</h3>
          <p class="uses">{v.uses}</p>
          <h3>
            {words(lang, "Damos forma a tu sesión", "We shape your session")}
          </h3>
          <p>
            {words(
              lang,
              "Definimos juntos el alcance, las locaciones, los formatos de entrega y el uso de las imágenes. La propuesta se prepara según tu proyecto.",
              "Together we define the scope, locations, delivery formats and use of the images. Your proposal is tailored to the project.",
            )}
          </p>
          <a
            class="solid-link"
            href={contactLink(lang, v.inquiry)}
            data-analytics-label={`services_${v.id}`}
          >
            {words(lang, "Cuéntame tu idea", "Tell me your idea")}
            <Arrow />
          </a>
          <a class="quiet-link" href={`/${lang}/gallery/${v.id}/`}>
            {words(lang, "Ver el trabajo", "Explore the work")}
          </a>
        </div>
      </section>
    ))}
    <ContactCTA />
  </main>
  <Footer />
</BaseLayout>
