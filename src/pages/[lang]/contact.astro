---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import InquiryForm from "../../components/InquiryForm.astro";
import { words, type Lang } from "../../lib/editorial";
export function getStaticPaths() {
  return ["es", "en"].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
---

<BaseLayout
  title={words(lang, "Cuéntame tu proyecto", "Tell me about your project")}
  pageType="contact"
>
  <Header />
  <main id="main" class="contact-page">
    <section class="contact-intro">
      <h1>
        {words(lang, "Todo empieza", "It all starts")}
        <br />
        <em>{words(lang, "con una idea.", "with an idea.")}</em>
      </h1>
      <p>
        {words(
          lang,
          "Cuéntame la tuya. No necesitas tener todo resuelto: podemos encontrar juntos la forma de fotografiarlo.",
          "Tell me yours. You don’t need to have everything figured out — we can find the right way to photograph it together.",
        )}
      </p>
      <div class="contact-direct">
        <span>
          {words(
            lang,
            "¿Prefieres escribir directamente?",
            "Prefer to write directly?",
          )}
        </span>
        <a href="mailto:inspecjrm@gmail.com">inspecjrm@gmail.com</a>
        <span>Ciudad de México · ES / EN</span>
      </div>
    </section>
    <InquiryForm lang={lang} />
  </main>
  <Footer />
</BaseLayout>
