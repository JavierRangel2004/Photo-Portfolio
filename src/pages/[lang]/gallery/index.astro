---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import EditorialGallery from "../../../components/EditorialGallery.astro";
import ContactCTA from "../../../components/ContactCTA.astro";
import { words, type Lang } from "../../../lib/editorial";
export function getStaticPaths() {
  return ["es", "en"].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
---

<BaseLayout
  title={words(lang, "Trabajo seleccionado", "Selected work")}
  pageType="portfolio"
>
  <Header />
  <main id="main">
    <section class="page-intro gallery-intro">
      <h1>
        {words(lang, "Trabajo", "Selected")}
        <br />
        <em>{words(lang, "seleccionado.", "work.")}</em>
      </h1>
      <p>
        {words(
          lang,
          "Luz, presencia, energía. Una edición de imágenes para detenerte un momento.",
          "Light, presence, energy. An edit of images to spend a moment with.",
        )}
      </p>
    </section>
    <EditorialGallery lang={lang} />
    <ContactCTA />
  </main>
  <Footer />
</BaseLayout>
