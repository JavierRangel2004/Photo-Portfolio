---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import EditorialGallery from "../../../components/EditorialGallery.astro";
import ContactCTA from "../../../components/ContactCTA.astro";
import {
  verticals,
  words,
  contactLink,
  type Lang,
} from "../../../lib/editorial";
export function getStaticPaths() {
  return ["es", "en"].flatMap((lang) =>
    ["product", "portraits", "events", "archive", "branding"].map((group) => ({
      params: { lang, group },
    })),
  );
}
const lang = Astro.params.lang as Lang;
const group =
  Astro.params.group === "branding" ? "portraits" : Astro.params.group;
const v = verticals(lang).find((v) => v.id === group);
const title = v?.name || words(lang, "Archivo personal", "Personal archive");
---

<BaseLayout title={title} pageType="portfolio">
  <Header />
  <main id="main">
    <section class="page-intro gallery-intro">
      <h1>
        {title}
        <em>
          {v
            ? words(lang, "con intención.", "with intention.")
            : words(lang, "otras formas de mirar.", "other ways of seeing.")}
        </em>
      </h1>
      <div>
        <p>
          {v?.description ||
            words(
              lang,
              "Naturaleza, ciudad y encuentros que invitan a mirar más despacio. Mi exploración personal fuera del encargo.",
              "Nature, cities and encounters that invite a slower look. My personal explorations beyond commissioned work.",
            )}
        </p>
        {v && (
          <a class="text-link" href={contactLink(lang, v.inquiry)}>
            {words(lang, "Quiero fotos así", "I want photos like these")} ↗
          </a>
        )}
      </div>
    </section>
    <EditorialGallery lang={lang} group={group} />
    <ContactCTA />
  </main>
  <Footer />
</BaseLayout>
