---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { Image } from "astro:assets";
import portrait from "../../assets/images/yo.jpg";
import { words, type Lang } from "../../lib/editorial";
export function getStaticPaths() {
  return ["es", "en"].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
---

<BaseLayout
  title={words(lang, "Javier Rangel · La mirada", "Javier Rangel · The eye")}
  pageType="about"
>
  <Header />
  <main id="main">
    <section class="page-intro">
      <h1>
        {words(lang, "Primero mirar.", "Look first.")}
        <br />
        <em>{words(lang, "Después, fotografiar.", "Then photograph.")}</em>
      </h1>
    </section>
    <section class="about-story">
      <div data-reveal-image>
        <Image
          src={portrait}
          alt="Javier Rangel"
          widths={[480, 800, 1200]}
          sizes="(max-width: 700px) 90vw, 45vw"
          loading="eager"
        />
        <p class="image-note">Javier Rangel · JRMGraphy</p>
      </div>
      <div>
        <h2>
          {words(lang, "Una mirada propia,", "An eye of my own,")}
          <br />
          <em>
            {words(lang, "una historia compartida.", "a story we share.")}
          </em>
        </h2>
        <p>
          {words(
            lang,
            "Soy Javier Rangel, fotógrafo en Ciudad de México. Mi trabajo se mueve entre el retrato, el producto y la energía de los eventos y la música.",
            "I’m Javier Rangel, a photographer based in Mexico City. My work moves between portraiture, products and the energy of live events and music.",
          )}
        </p>
        <p>
          {words(
            lang,
            "Me interesa encontrar lo que hace particular a cada persona, objeto o momento. Dirigir sin forzar. Cuidar la luz sin perder lo que está pasando. Hacer imágenes que se sientan auténticas y tengan un propósito.",
            "I look for what makes each person, object or moment particular. Directing without forcing. Shaping the light without losing what’s happening. Making images that feel authentic and have a purpose.",
          )}
        </p>
        <p>
          {words(
            lang,
            "Antes de una sesión, quiero entender tu proyecto: qué necesitas comunicar y qué esperas que alguien sienta al verlo. De ahí parte todo.",
            "Before a session, I want to understand your project: what you need to communicate and what you hope someone feels when they see it. Everything starts there.",
          )}
        </p>
        <a class="text-link" href={`/${lang}/gallery/`}>
          {words(lang, "Explora mi trabajo", "Explore my work")} ↗
        </a>
      </div>
    </section>
    <ContactCTA />
  </main>
  <Footer />
</BaseLayout>
