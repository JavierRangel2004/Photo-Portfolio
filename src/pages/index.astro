---
// SEO & UX optimized Root Redirector
// Using Astro's middleware or server-side functions would be better but this is a static build
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>JRMGraphy</title>
    {process.env.CONTEXT !== "production" && (
      <meta name="robots" content="noindex,follow" />
    )}
    <!-- Basic SEO to tell bots to index the correct localized version -->
    <link rel="canonical" href="https://jrmgraphy.com/es/" />
    <link rel="alternate" hreflang="es" href="https://jrmgraphy.com/es/" />
    <link rel="alternate" hreflang="en" href="https://jrmgraphy.com/en/" />
    <link
      rel="alternate"
      hreflang="x-default"
      href="https://jrmgraphy.com/es/"
    />

    <style>
      body {
        background-color: #f0eee8;
        color: #252720;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
      }
      .loader {
        opacity: 0;
        animation: fadeIn 0.5s ease-in 0.5s forwards;
      }
      @keyframes fadeIn {
        to {
          opacity: 1;
        }
      }
    </style>

    <script>
      (function () {
        // 1. Check for saved preference
        let preferred: string | null = null;
        try {
          preferred = localStorage.getItem("preferredLang");
        } catch {}
        if (preferred === "en" || preferred === "es") {
          window.location.replace(
            "/" + preferred + "/" + window.location.search,
          );
          return;
        }

        // 2. Check for browser language
        const browserLang =
          navigator.language || (navigator as any).userLanguage;
        if (browserLang && browserLang.toLowerCase().startsWith("en")) {
          window.location.replace("/en/" + window.location.search);
        } else {
          // Fallback to default language
          window.location.replace("/es/" + window.location.search);
        }
      })();
    </script>
  </head>
  <body>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/es/" />
    </noscript>
    <div class="loader">JRMGraphy</div>
  </body>
</html>
