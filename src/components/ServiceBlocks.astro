---
import { Image } from 'astro:assets';
import {
  getCuratedPhotosByGroup,
  getRandomPhotosByCategory,
  getPhotosByCategory,
} from '../lib/photos';
import type { Photo } from '../lib/photos';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

type ServiceLineId = 'branding' | 'events' | 'gastronomy';

interface ServiceLine {
  id: ServiceLineId;
  anchor: string;
  title: string;
  description: string;
  cta: string;
  points: string[];
  cover?: Photo;
}

function productCover(): Photo | undefined {
  const productPhotos = getPhotosByCategory('product');
  if (productPhotos.length === 0) {
    return getCuratedPhotosByGroup('branding', 1)[0];
  }
  const curated = getRandomPhotosByCategory('product', 1);
  return curated[0] ?? productPhotos[0];
}

const lines: ServiceLine[] = [
  {
    id: 'branding',
    anchor: 'branding',
    title: t('service.branding.title'),
    description: t('service.branding.desc'),
    cta: t('service.branding.cta'),
    points: [
      t('service.branding.point.one'),
      t('service.branding.point.two'),
      t('service.branding.point.three'),
    ],
    cover: getCuratedPhotosByGroup('branding', 1)[0],
  },
  {
    id: 'events',
    anchor: 'events',
    title: t('service.events.title'),
    description: t('service.events.desc'),
    cta: t('service.events.cta'),
    points: [
      t('service.events.point.one'),
      t('service.events.point.two'),
      t('service.events.point.three'),
    ],
    cover: getCuratedPhotosByGroup('events', 1)[0],
  },
  {
    id: 'gastronomy',
    anchor: 'gastronomy',
    title: t('service.archive.title'),
    description: t('service.archive.desc'),
    cta: t('service.archive.cta'),
    points: [
      t('service.archive.point.one'),
      t('service.archive.point.two'),
      t('service.archive.point.three'),
    ],
    cover: productCover(),
  },
];
---

<section class="services-overview" id="home-services" aria-label={t('servicesBlocks.title')}>
  <div class="services-overview-header reveal">
    <div class="section-heading">
      <p class="section-eyebrow">{t('servicesBlocks.eyebrow')}</p>
      <h2 class="section-title">{t('servicesBlocks.title')}</h2>
      <p class="section-subtitle">{t('servicesBlocks.subtitle')}</p>
    </div>
  </div>

  <div class="services-overview-grid">
    {lines.map((line, index) => (
      <a
        href={`${translatePath('/services')}#${line.anchor}`}
        class={`service-overview-card reveal ${index === 0 ? 'service-overview-card--featured' : ''}`}
        style={`transition-delay: ${index * 0.08}s`}
      >
        <div class="service-overview-media">
          {line.cover && (
            <Image
              src={line.cover.src}
              alt={line.title}
              width={line.cover.width || 1600}
              height={line.cover.height || 1200}
              sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
              loading="lazy"
            />
          )}
        </div>
        <div class="service-overview-body">
          <p class="service-overview-kicker">{line.cta} &rarr;</p>
          <h3>{line.title}</h3>
          <p>{line.description}</p>
          <ul class="service-overview-points">
            {line.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
      </a>
    ))}
  </div>
</section>
