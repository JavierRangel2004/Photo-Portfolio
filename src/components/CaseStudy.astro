---
import { Image } from 'astro:assets';
import { getHeroPhoto } from '../lib/photos';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const photo = getHeroPhoto();

const pillars = [
  { label: 'L', title: t('case.light.title'), body: t('case.light.body') },
  { label: 'C', title: t('case.composition.title'), body: t('case.composition.body') },
  { label: 'M', title: t('case.moment.title'), body: t('case.moment.body') },
];
---

<section class="case-study" aria-label="L-C-M case study">
  <div class="case-study-shell">
    <div class="case-study-header reveal">
      <p class="section-eyebrow">{t('case.eyebrow')}</p>
      <h2 class="section-title">{t('case.title')}</h2>
      <p class="section-subtitle">{t('case.intro')}</p>
    </div>

    <div class="case-study-body">
      <div class="case-study-media reveal">
        {photo && (
          <Image
            src={photo.src}
            alt={lang === 'es'
              ? 'Retrato editorial de fundador en sesión en Ciudad de México — análisis L-C-M'
              : 'Editorial founder portrait from a session in Mexico City — L-C-M breakdown'}
            width={photo.width || 1600}
            height={photo.height || 1200}
            sizes="(min-width: 1024px) 50vw, 100vw"
            loading="lazy"
          />
        )}
      </div>

      <div class="case-study-pillars">
        {pillars.map((pillar, index) => (
          <article
            class="case-study-pillar reveal"
            style={`transition-delay: ${index * 0.08}s`}
          >
            <span class="case-study-pillar-label" aria-hidden="true">{pillar.label}</span>
            <div>
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="case-study-footer reveal">
      <a href={translatePath('/gallery')} class="btn btn-ghost">{t('case.cta')}</a>
    </div>
  </div>
</section>

<style>
  .case-study {
    padding: 6rem 1.5rem;
    background: linear-gradient(180deg, rgba(17, 9, 28, 0.75), rgba(10, 10, 10, 0.98));
    border-block: 1px solid rgba(255, 255, 255, 0.06);
  }

  .case-study-shell {
    max-width: 80rem;
    margin: 0 auto;
  }

  .case-study-header {
    max-width: 44rem;
    margin-bottom: 3rem;
  }

  .case-study-body {
    display: grid;
    gap: 2.5rem;
  }

  .case-study-media {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 28px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55);
  }

  .case-study-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .case-study-pillars {
    display: grid;
    gap: 1rem;
  }

  .case-study-pillar {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .case-study-pillar:hover {
    border-color: rgba(214, 179, 106, 0.45);
    transform: translateY(-2px);
  }

  .case-study-pillar-label {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid rgba(214, 179, 106, 0.4);
    color: #D6B36A;
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 1.1rem;
    letter-spacing: 0.05em;
  }

  .case-study-pillar h3 {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 1.25rem;
    color: var(--color-text, #F5F1E8);
    margin: 0 0 0.35rem;
  }

  .case-study-pillar p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-muted, #A8A29E);
    margin: 0;
  }

  .case-study-footer {
    margin-top: 3rem;
    display: flex;
    justify-content: flex-start;
  }

  @media (min-width: 960px) {
    .case-study {
      padding: 7rem 2rem;
    }

    .case-study-body {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: stretch;
    }

    .case-study-media {
      min-height: 100%;
    }

    .case-study-pillars {
      gap: 1.25rem;
    }
  }
</style>
