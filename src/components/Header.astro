---
import { getLangFromUrl, getRouteWithoutLang } from "../i18n/utils";
import BrandSignature from "./BrandSignature.astro";
import { words } from "../lib/editorial";
import Arrow from "./Arrow.astro";
const lang = getLangFromUrl(Astro.url);
const other = lang === "es" ? "en" : "es";
const route = getRouteWithoutLang(Astro.url);
const links = [
  ["gallery", words(lang, "Trabajo", "Work")],
  ["services", words(lang, "Servicios", "Services")],
  ["about", words(lang, "La mirada", "The eye")],
];
const translatedRoute =
  route.startsWith("/fotograf") ||
  route.startsWith("/retrato-") ||
  route.startsWith("/fotos-")
    ? "/"
    : route;
---

<header class="masthead">
  <a
    class="wordmark brand-signature"
    href={`/${lang}/`}
    aria-label={words(lang, "Javier Rangel — Inicio", "Javier Rangel — Home")}
  >
    <BrandSignature />
  </a>
  <nav class="desktop-nav" aria-label={words(lang, "Principal", "Main")}>
    {links.map(([path, label]) => (
      <a
        href={`/${lang}/${path}/`}
        aria-current={Astro.url.pathname.includes(path) ? "page" : undefined}
      >
        {label}
      </a>
    ))}
  </nav>
  <div class="nav-end">
    <a
      class="language"
      href={`/${other}${translatedRoute}`}
      lang={other}
      aria-label={words(lang, "Switch to English", "Cambiar a español")}
    >
      {other.toUpperCase()}
    </a>
    <a class="nav-inquiry" href={`/${lang}/contact/`}>
      {words(lang, "Hablemos", "Let’s talk")}
      <Arrow />
    </a>
    <button
      class="menu-toggle"
      aria-label={words(lang, "Abrir menú", "Open menu")}
      aria-haspopup="dialog"
      aria-controls="mobile-menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>
<noscript>
  <nav
    class="fallback-nav"
    aria-label={words(lang, "Navegación", "Navigation")}
  >
    {links.map(([path, label]) => (
      <a href={`/${lang}/${path}/`}>{label}</a>
    ))}
  </nav>
</noscript>
<dialog
  id="mobile-menu"
  class="mobile-menu"
  aria-label={words(lang, "Navegación", "Navigation")}
>
  <button class="menu-close" autofocus>
    {words(lang, "Cerrar", "Close")} <span aria-hidden="true">×</span>
  </button>
  <nav>
    {links.map(([path, label]) => (
      <a href={`/${lang}/${path}/`}>
        {label}
        <Arrow />
      </a>
    ))}
    <a href={`/${lang}/contact/`}>
      {words(lang, "Hablemos", "Let’s talk")}
      <Arrow />
    </a>
  </nav>
  <p>Javier Rangel · Ciudad de México</p>
</dialog>
<script>
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu");
  const opener = document.querySelector<HTMLButtonElement>(".menu-toggle");
  opener?.addEventListener("click", () => {
    menu?.showModal();
    document.body.classList.add("dialog-open");
  });
  menu?.querySelector("button")?.addEventListener("click", () => menu.close());
  menu?.addEventListener("click", (e) => {
    if (e.target === menu) menu.close();
  });
  menu?.addEventListener("close", () => {
    document.body.classList.remove("dialog-open");
    opener?.focus();
  });
</script>
