---
import { getHeroBackgroundPools } from '../lib/photos';
import smokeBack from '../assets/images/58a39fc5861fbc5e8be3491d9e50a7a2.png';
import smokeFront from '../assets/images/1ac1454f211aace6297927909a96039e.png';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const heroBgPools = getHeroBackgroundPools();
const heroDefaultSrc = heroBgPools.landscape[0]?.src ?? heroBgPools.portrait[0]?.src;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<section class="hero-scroll-scene" id="home-hero-scene" aria-label="Hero">
  <div class="hero" id="home-hero-pin">
    <div class="hero-bg" id="hero-bg">
      {heroDefaultSrc && (
        <img
          id="hero-img"
          class="hero-bg-img"
          src={heroDefaultSrc}
          alt="JRMGraphy hero"
          width={heroBgPools.landscape[0]?.width ?? heroBgPools.portrait[0]?.width ?? 1920}
          height={heroBgPools.landscape[0]?.height ?? heroBgPools.portrait[0]?.height ?? 1280}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )}
      {heroDefaultSrc && (
        <script
          is:inline
          type="application/json"
          id="hero-bg-pool-data"
          set:html={JSON.stringify({ landscape: heroBgPools.landscape, portrait: heroBgPools.portrait, breakpoint: 769 })}
        />
      )}
    </div>
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <p class="hero-eyebrow">{t('hero.eyebrow')}</p>
      <h1 class="hero-title">{t('hero.title')}</h1>
      <p class="hero-subtitle">{t('hero.subtitle')}</p>

      <div class="hero-tags">
        <span class="hero-tag">{t('hero.tag.one')}</span>
        <span class="hero-tag">{t('hero.tag.two')}</span>
        <span class="hero-tag">{t('hero.tag.three')}</span>
      </div>

      <div class="hero-actions">
        <a href={translatePath('/contact')} class="btn btn-primary" data-analytics-label="hero_primary_quote">{t('hero.cta.primary')}</a>
        <a href={translatePath('/gallery')} class="btn btn-ghost" data-analytics-label="hero_secondary_portfolio">{t('hero.cta.secondary')}</a>
      </div>
    </div>

    <div class="smoke-transition" aria-hidden="true">
      <img
        class="smoke-layer smoke-layer--back"
        src={smokeBack.src}
        width={smokeBack.width}
        height={smokeBack.height}
        alt=""
        loading="eager"
        decoding="async"
      />
      <img
        class="smoke-layer smoke-layer--front"
        src={smokeFront.src}
        width={smokeFront.width}
        height={smokeFront.height}
        alt=""
        loading="eager"
        decoding="async"
      />
    </div>

    <a class="hero-scroll" id="hero-scroll" href="#home-services" aria-label={t('hero.scroll')}>
      <span class="hero-scroll-text">{t('hero.scroll')}</span>
      <span class="hero-scroll-icon" aria-hidden="true"></span>
    </a>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const HERO_BREAKPOINT = 769;

  const poolJson = document.getElementById('hero-bg-pool-data');
  const heroImg = document.getElementById('hero-img') as HTMLImageElement | null;

  if (poolJson?.textContent && heroImg) {
    type Pool = { src: string; width: number; height: number };
    const data = JSON.parse(poolJson.textContent) as {
      landscape: Pool[];
      portrait: Pool[];
      breakpoint?: number;
    };
    const bp = data.breakpoint ?? HERO_BREAKPOINT;
    const desktopQ = window.matchMedia(`(min-width: ${bp}px)`);

    const pickPool = () => (desktopQ.matches ? data.landscape : data.portrait);

    const applyRandomHero = () => {
      const pool = pickPool();
      if (!pool.length) return;
      const pick = pool[Math.floor(Math.random() * pool.length)];
      heroImg.classList.remove('loaded');
      heroImg.src = pick.src;
      heroImg.width = pick.width;
      heroImg.height = pick.height;
      if (heroImg.complete) heroImg.classList.add('loaded');
    };

    applyRandomHero();

    const onViewportForHero = () => {
      applyRandomHero();
    };
    desktopQ.addEventListener('change', onViewportForHero);

    heroImg.addEventListener('load', () => heroImg.classList.add('loaded'));
    if (heroImg.complete) heroImg.classList.add('loaded');
  } else if (heroImg) {
    heroImg.addEventListener('load', () => heroImg.classList.add('loaded'));
    if (heroImg.complete) heroImg.classList.add('loaded');
  }

  const heroScene = document.querySelector<HTMLElement>('#home-hero-scene');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (heroScene && heroImg && !prefersReducedMotion) {
    const ctx = gsap.context(() => {
      const timeline = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: heroScene,
          start: 'top top',
          end: '+=70%',
          scrub: 0.85,
          pin: true,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      timeline
        .to('.hero-content', { y: -80, opacity: 0, duration: 0.3 }, 0)
        .to(heroImg, { scale: 1.07, duration: 1 }, 0)
        .to('.smoke-transition', { y: '-5vh', duration: 1 }, 0)
        .to('.smoke-layer--back', { y: '-16vh', scale: 1.1, opacity: 0.74, duration: 0.75 }, 0.02)
        .to('.smoke-layer--front', { y: '-32vh', scale: 2.0, opacity: 0.82, duration: 0.72 }, 0.06)
        .to(heroScene, { '--hero-blackout-opacity': 1, duration: 0.22 }, 0.78);

      ScrollTrigger.refresh();
    }, heroScene);

    window.addEventListener('pagehide', () => ctx.revert(), { once: true });
  }

  const heroScroll = document.getElementById('hero-scroll');
  if (heroScroll) {
    const toggleHeroScroll = () => {
      const shouldHide = window.scrollY > 24;
      heroScroll.classList.toggle('is-hidden', shouldHide);
      heroScroll.classList.toggle('is-visible', !shouldHide);
    };

    requestAnimationFrame(toggleHeroScroll);
    window.addEventListener('scroll', toggleHeroScroll, { passive: true });
  }
</script>

<style>
  .hero-title {
    font-family: var(--font-heading, theme('fontFamily.heading'));
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--color-primary);
    max-width: 25ch;
    margin-inline: auto;
    margin-bottom: 1.5rem;
    opacity: 0;
    transform: translateY(14px);
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    font-weight: 400;
    color: var(--color-text-muted);
    max-width: 50ch;
    margin-inline: auto;
    margin-bottom: 2rem;
    line-height: 1.6;
    opacity: 0;
    transform: translateY(14px);
    animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.7s forwards;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.5rem;
    max-width: 48rem;
    opacity: 0;
    transform: translateY(14px);
    animation: reveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.75s forwards;
  }

  .hero-tag {
    color: var(--color-text-dim);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-tag + .hero-tag {
    padding-left: 0.7rem;
    border-left: 1px solid rgba(245, 241, 232, 0.18);
  }

  .hero-tags {
    justify-content: center;
    margin-inline: auto;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
    flex-direction: column;
    width: 100%;
    opacity: 0;
    transform: translateY(16px);
    animation: reveal 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
  }

  @media (min-width: 769px) {
    .hero-tags {
      justify-content: flex-start;
      margin-inline: unset;
    }

    .hero-actions {
      flex-direction: row;
      width: auto;
      margin-bottom: 3rem;
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: clamp(2.2rem, 10vw, 3rem);
      max-width: 10.5ch;
      margin-bottom: 1rem;
    }

    .hero-subtitle {
      font-size: 1rem;
      line-height: 1.55;
      margin-bottom: 1.25rem;
    }

    .hero-tags {
      margin-top: 1rem;
      row-gap: 0.25rem;
    }

    .hero-actions {
      gap: 0.75rem;
      margin-top: 1.35rem;
    }
  }
</style>
