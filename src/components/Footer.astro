---
import { getLangFromUrl } from "../i18n/utils";
import { words } from "../lib/editorial";
const lang = getLangFromUrl(Astro.url);
---

<footer class="site-footer">
  <div class="footer-top">
    <a href={`/${lang}/`} class="wordmark">
      jrm<span>graphy</span>
    </a>
    <p>
      Javier Rangel
      <br />
      Ciudad de México
    </p>
    <div>
      <a href="mailto:inspecjrm@gmail.com">inspecjrm@gmail.com</a>
      <a
        href="https://www.instagram.com/JRM_Graphy"
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram ↗
      </a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} JRMGraphy</span>
    <span>
      {words(lang, "Una mirada propia.", "A point of view of my own.")}
    </span>
    <a href="#top">{words(lang, "Volver arriba", "Back to top")} ↑</a>
  </div>
</footer>
