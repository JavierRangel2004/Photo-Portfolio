---
import { getLangFromUrl } from "../i18n/utils";
import { words } from "../lib/editorial";
import Arrow from "./Arrow.astro";
const lang = getLangFromUrl(Astro.url);
---

<section class="contact-close">
  <p>
    {words(
      lang,
      "Tu próximo proyecto empieza con una conversación.",
      "Your next project starts with a conversation.",
    )}
  </p>
  <a
    href={`/${lang}/contact/`}
    class="contact-display"
    data-analytics-label="closing_contact"
  >
    {words(lang, "Hagamos", "Let’s make")}
    <br />
    <em>{words(lang, "algo memorable.", "it memorable.")}</em>
    <Arrow />
  </a>
  <div class="contact-close-bottom">
    <span>
      {words(
        lang,
        "Producto / Gastro · Retrato · Eventos / Música",
        "Product / Food · Portraits · Events / Music",
      )}
    </span>
    <a href="mailto:inspecjrm@gmail.com">inspecjrm@gmail.com</a>
  </div>
</section>
