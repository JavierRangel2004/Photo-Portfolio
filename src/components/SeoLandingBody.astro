---
import EditorialImage from "./EditorialImage.astro";
import type { Photo } from "../lib/photos";
interface Props {
  eyebrow: string;
  title: string;
  answerFirst: string;
  subtitle?: string;
  heroPhoto?: Photo;
  sections: Array<{ title: string; body: string }>;
  bullets?: string[];
  faq?: Array<{ question: string; answer: string }>;
  ctaTitle: string;
  ctaBody: string;
  ctaLabel: string;
  lang: "es" | "en";
}
const {
  title,
  answerFirst,
  subtitle,
  heroPhoto,
  sections,
  bullets = [],
  faq = [],
  ctaTitle,
  ctaBody,
  ctaLabel,
  lang,
} = Astro.props;
---

<main id="main" class="seo-page">
  <section class="page-intro">
    <h1>{title}</h1>
    <div>
      <p>{subtitle}</p>
      <a class="solid-link" href={`/${lang}/contact/`}>
        {ctaLabel} ↗
      </a>
    </div>
  </section>
  <section class="seo-overview">
    {heroPhoto && <EditorialImage photo={heroPhoto} alt={title} eager />}
    <p>{answerFirst}</p>
  </section>
  <div class="seo-sections">
    {sections.map((s) => (
      <section>
        <h2>{s.title}</h2>
        <p>{s.body}</p>
      </section>
    ))}
    {bullets.length > 0 && (
      <ul>
        {bullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    )}
  </div>
  {faq.length > 0 && (
    <section class="faq">
      <h2>{lang === "es" ? "Antes de la sesión" : "Before the session"}</h2>
      {faq.map((f) => (
        <details>
          <summary>
            {f.question}
            <span>+</span>
          </summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </section>
  )}
  <section class="seo-cta">
    <h2>{ctaTitle}</h2>
    <p>{ctaBody}</p>
    <a class="solid-link" href={`/${lang}/contact/`}>
      {ctaLabel} ↗
    </a>
  </section>
</main>
