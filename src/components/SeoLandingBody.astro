---
import { Image } from 'astro:assets';
import { useTranslatedPath } from '../i18n/utils';
import type { Photo } from '../lib/photos';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow: string;
  title: string;
  answerFirst: string;
  subtitle?: string;
  heroPhoto?: Photo;
  sections: Array<{ title: string; body: string }>;
  bullets?: string[];
  faq?: FaqItem[];
  ctaTitle: string;
  ctaBody: string;
  ctaLabel: string;
  lang: 'es' | 'en';
}

const {
  eyebrow,
  title,
  answerFirst,
  subtitle,
  heroPhoto,
  sections,
  bullets = [],
  faq = [],
  ctaTitle,
  ctaBody,
  ctaLabel,
  lang,
} = Astro.props;

const translatePath = useTranslatedPath(lang);
---

<main class="site-main bg-background pb-40">
  <section class="border-b border-white/5 bg-background py-20 md:py-28">
    <div class="mx-auto grid w-full max-w-7xl gap-10 px-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-center">
      <div>
        <p class="section-eyebrow reveal text-left uppercase tracking-[0.2em] text-[#D6B36A]">
          {eyebrow}
        </p>
        <h1 class="reveal stagger-1 mt-4 max-w-4xl text-left font-heading text-4xl leading-[1.04] tracking-[-0.02em] text-text md:text-5xl lg:text-6xl">
          {title}
        </h1>
        {subtitle && (
          <p class="reveal stagger-2 mt-5 max-w-2xl text-left text-base leading-7 text-text-muted lg:text-lg">
            {subtitle}
          </p>
        )}
        <div class="reveal stagger-3 mt-8 flex flex-wrap gap-3">
          <a href={translatePath('/contact')} class="btn btn-primary" data-analytics-label="landing_hero_contact">{ctaLabel}</a>
          <a href={translatePath('/gallery')} class="btn btn-ghost" data-analytics-label="landing_hero_portfolio">
            {lang === 'es' ? 'Ver portafolio' : 'View portfolio'}
          </a>
        </div>
      </div>
      {heroPhoto && (
        <div class="reveal relative overflow-hidden rounded-[28px] border border-white/10 bg-black shadow-[0_30px_60px_rgba(0,0,0,0.55)]">
          <Image
            src={heroPhoto.src}
            alt={title}
            width={heroPhoto.width || 1400}
            height={heroPhoto.height || 1800}
            sizes="(min-width: 1024px) 40vw, 90vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}
    </div>
  </section>

  <section class="border-b border-white/10 bg-background py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-6">
      <p class="reveal prose-measure-lg text-base leading-8 text-text lg:text-lg">
        {answerFirst}
      </p>
    </div>
  </section>

  {sections.length > 0 && (
    <section class="border-b border-white/10 bg-background py-16 md:py-20">
      <div class="mx-auto max-w-7xl space-y-14 px-6">
        {sections.map((section, index) => (
          <article class="reveal grid gap-4 lg:grid-cols-[minmax(0,0.4fr)_minmax(0,0.6fr)] lg:gap-10" style={`transition-delay: ${index * 0.05}s`}>
            <h2 class="font-heading text-2xl leading-[1.1] tracking-[-0.01em] text-text md:text-3xl">
              {section.title}
            </h2>
            <p class="prose-measure text-base leading-8 text-text-muted">
              {section.body}
            </p>
          </article>
        ))}
      </div>
    </section>
  )}

  {bullets.length > 0 && (
    <section class="border-b border-white/10 bg-background py-16 md:py-20">
      <div class="mx-auto max-w-7xl px-6">
        <h2 class="reveal font-heading text-3xl leading-[1.08] tracking-[-0.02em] text-text md:text-4xl">
          {lang === 'es' ? 'Qué recibes' : 'What you get'}
        </h2>
        <ul class="reveal stagger-1 mt-8 grid gap-4 md:grid-cols-2">
          {bullets.map((item) => (
            <li class="flex gap-3 rounded-[20px] border border-white/10 bg-white/[0.03] p-5 text-base leading-7 text-text-muted">
              <span class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-[#D6B36A]" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {faq.length > 0 && (
    <section class="border-b border-white/10 bg-background py-16 md:py-20">
      <div class="mx-auto max-w-4xl px-6">
        <h2 class="reveal font-heading text-3xl leading-[1.08] tracking-[-0.02em] text-text md:text-4xl">
          {lang === 'es' ? 'Preguntas frecuentes' : 'Frequently asked'}
        </h2>
        <div class="reveal stagger-1 mt-8 space-y-3">
          {faq.map((item) => (
            <details class="group rounded-[20px] border border-white/10 bg-white/[0.03] p-5 transition hover:border-secondary">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-heading text-lg leading-[1.3] text-text">
                <span>{item.question}</span>
                <span aria-hidden="true" class="text-[#D6B36A] transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 prose-measure text-base leading-7 text-text-muted">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-background py-20 md:py-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="rounded-[28px] border border-white/10 bg-gradient-to-br from-white/[0.05] to-white/0 p-10 text-center shadow-[0_30px_60px_rgba(0,0,0,0.55)] backdrop-blur-md">
        <h2 class="reveal font-heading text-3xl leading-[1.08] tracking-[-0.02em] text-text md:text-4xl">
          {ctaTitle}
        </h2>
        <p class="reveal stagger-1 mt-4 text-base leading-7 text-text-muted lg:text-lg">
          {ctaBody}
        </p>
        <div class="reveal stagger-2 mt-6 flex flex-wrap justify-center gap-3">
          <a
            href={translatePath('/contact')}
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#D6B36A] bg-[#D6B36A] px-6 py-3 font-sans text-sm font-medium uppercase tracking-[0.08em] text-[#0A0A0A] transition-all duration-base hover:-translate-y-px hover:border-[#FFFFFF] hover:bg-[#FFFFFF]"
            data-analytics-label="landing_bottom_contact"
          >
            {ctaLabel}
          </a>
        </div>
      </div>
    </div>
  </section>
</main>
