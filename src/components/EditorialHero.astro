---
import { Image } from "astro:assets";
import mark from "../assets/images/logo-bosque.png";
import { getLangFromUrl } from "../i18n/utils";
import {
  responsiveSrcset,
  describePhoto,
  verticals,
  words,
} from "../lib/editorial";
import Arrow from "./Arrow.astro";
import RootSystem from "./RootSystem.astro";
const lang = getLangFromUrl(Astro.url);
const items = verticals(lang);
---

<section class="roots-hero" aria-labelledby="hero-title">
  <div class="roots-heading">
    <h1 id="hero-title">
      <span>{words(lang, "Hay imágenes", "Some images")}</span>
      <em>{words(lang, "que se quedan.", "stay with you.")}</em>
    </h1>
    <div class="roots-intro">
      <p>
        {words(
          lang,
          "Fotografía para lo que creas, lo que eres y lo que sucede.",
          "Photography for what you create, who you are and what unfolds.",
        )}
      </p>
      <a class="text-link" href={`/${lang}/contact/`}>
        {words(lang, "Cuéntame tu proyecto", "Tell me about your project")}
        <Arrow />
      </a>
    </div>
  </div>
  <div class="roots-garden">
    <div class="roots-origin" aria-hidden="true">
      <Image
        src={mark}
        alt=""
        aria-hidden="true"
        width={100}
        height={100}
        format="webp"
      />
    </div>
    <RootSystem />
    <canvas class="root-field" aria-hidden="true"></canvas>
    <div class="root-narrative" aria-hidden="true">
      <div data-root-story="product">
        <span>{words(lang, "Lo que creas.", "What you create.")}</span>
        <p>
          {words(
            lang,
            "Del detalle nace el deseo.",
            "Desire starts in the details.",
          )}
        </p>
      </div>
      <div data-root-story="portraits">
        <span>{words(lang, "Lo que eres.", "Who you are.")}</span>
        <p>
          {words(
            lang,
            "Una presencia irrepetible.",
            "A presence like no other.",
          )}
        </p>
      </div>
      <div data-root-story="events">
        <span>{words(lang, "Lo que sucede.", "What unfolds.")}</span>
        <p>
          {words(
            lang,
            "La energía también deja huella.",
            "Energy leaves its mark.",
          )}
        </p>
      </div>
    </div>
    <div class="roots-caption">
      <span>Javier Rangel · CDMX</span>
      <p>
        {words(lang, "Tres universos.", "Three worlds.")}
        <br />
        <em>{words(lang, "Una misma raíz.", "One shared root.")}</em>
      </p>
    </div>
    {items.map((v) => (
      <a
        class={`root-world root-world--${v.id}`}
        data-world={v.id}
        href={`/${lang}/gallery/${v.id}/`}
      >
        <div class="root-aperture">
          <img
            style={{ objectPosition: v.heroPosition }}
            src={encodeURI(v.hero.src)}
            srcset={responsiveSrcset(v.hero)}
            sizes="(max-width: 600px) 60vw, 36vw"
            alt={describePhoto(v.hero, lang) || v.name}
            width={v.hero.width}
            height={v.hero.height}
            loading="eager"
            fetchpriority={v.id === "product" ? "high" : "auto"}
          />
        </div>
        <div class="root-world-label">
          <span>{v.name}</span>
          <Arrow />
        </div>
      </a>
    ))}
    <a class="roots-scroll" href="#selected-work">
      {words(lang, "Sigue la raíz", "Follow the root")}
      <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>
<script>
  import "../scripts/roots";
</script>
