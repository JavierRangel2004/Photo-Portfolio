---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  photo: {
    id: string;
    category: string;
    src: string;
    date: string;
    sessionDate: string;
    originalName: string;
    width?: number;
    height?: number;
  };
  lightboxGroup?: string;
  loading?: 'eager' | 'lazy';
  label?: string;
  sizes?: string;
}

const {
  photo,
  lightboxGroup = 'default',
  loading = 'lazy',
  label,
  sizes = '(min-width: 1400px) 20vw, (min-width: 1024px) 33vw, 50vw',
} = Astro.props;

const orientation =
  !photo.width || !photo.height
    ? 'landscape'
    : photo.width === photo.height
      ? 'square'
      : photo.width > photo.height
        ? 'landscape'
        : 'portrait';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const displayCategory = label || t(`category.${photo.category}` as any) || photo.category;

const altByCategoryEs: Record<string, string> = {
  portraits: 'Retrato editorial por JRMGraphy en Ciudad de México',
  concert: 'Cobertura de concierto por JRMGraphy en Ciudad de México',
  product: 'Fotografía de producto por JRMGraphy en Ciudad de México',
  city: 'Fotografía urbana por JRMGraphy en Ciudad de México',
  nature: 'Fotografía documental de naturaleza por JRMGraphy',
  'travel-cityscape': 'Fotografía de viaje y cityscape por JRMGraphy',
};

const altByCategoryEn: Record<string, string> = {
  portraits: 'Editorial portrait by JRMGraphy in Mexico City',
  concert: 'Concert coverage by JRMGraphy in Mexico City',
  product: 'Product photography by JRMGraphy in Mexico City',
  city: 'Urban photography by JRMGraphy in Mexico City',
  nature: 'Documentary nature photography by JRMGraphy',
  'travel-cityscape': 'Travel and cityscape photography by JRMGraphy',
};

const altText =
  (lang === 'es' ? altByCategoryEs[photo.category] : altByCategoryEn[photo.category]) ??
  (lang === 'es'
    ? `Fotografía ${displayCategory.toLowerCase()} por JRMGraphy en Ciudad de México`
    : `${displayCategory} photography by JRMGraphy in Mexico City`);
---

<button
  type="button"
  class={`photo-card photo-card--${orientation}`}
  data-lightbox-src={photo.src}
  data-lightbox-cat={displayCategory}
  data-lightbox-id={photo.id}
  data-lightbox-group={lightboxGroup}
  data-orientation={orientation}
  aria-label={lang === 'es' ? `Ver fotografía de ${displayCategory.toLowerCase()}` : `View ${displayCategory} photo`}
>
  <Image
    src={photo.src}
    alt={altText}
    width={photo.width}
    height={photo.height}
    sizes={sizes}
    loading={loading}
  />
  <div class="photo-card-overlay"></div>
  <span class="photo-card-cat">{displayCategory}</span>
</button>
