---
import "../styles/fonts.css";
import "../styles/editorial.css";
import Analytics from "../components/Analytics.astro";
import { getLangFromUrl, getRouteWithoutLang } from "../i18n/utils";
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  pageType?: string;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}
const {
  title,
  description = getLangFromUrl(Astro.url) === "es"
    ? "Javier Rangel — fotografía de producto, retrato y eventos en Ciudad de México."
    : "Javier Rangel — product, portrait and event photography in Mexico City.",
  ogImage = "/photos/product/product%20(35).webp",
  schema,
  noindex = false,
} = Astro.props;
const lang = getLangFromUrl(Astro.url),
  route = getRouteWithoutLang(Astro.url);
const site = "https://jrmgraphy.com",
  canonical = new URL(`/${lang}${route}`, site);
const production = process.env.CONTEXT === "production";
const titleText = `${title} — JRMGraphy`;
const organization = {
  "@type": "ProfessionalService",
  "@id": `${site}/#organization`,
  name: "JRMGraphy — Javier Rangel",
  url: site,
  email: "inspecjrm@gmail.com",
  image: new URL(ogImage, site).href,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Ciudad de México",
    addressCountry: "MX",
  },
  sameAs: ["https://www.instagram.com/JRM_Graphy"],
};
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
  ],
};
const seoOnly = !["/", "/about", "/contact", "/services", "/gallery"].some(
  (p) =>
    route === p ||
    route === p + "/" ||
    (p === "/gallery" && route.startsWith("/gallery/")),
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleText}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f0eee8" />
    <meta name="jrmgraphy-build" content={process.env.COMMIT_REF || "local"} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {(noindex || !production) && (
      <meta name="robots" content="noindex,follow" />
    )}
    {!seoOnly && (
      <>
        <link rel="alternate" hreflang="es" href={`${site}/es${route}`} />
        <link rel="alternate" hreflang="en" href={`${site}/en${route}`} />
        <link
          rel="alternate"
          hreflang="x-default"
          href={`${site}/es${route}`}
        />
      </>
    )}
    <meta property="og:title" content={titleText} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(graph)}
    ></script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      {lang === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>
    <slot />
    <dialog
      class="photo-dialog"
      id="photo-dialog"
      aria-label={lang === "es" ? "Fotografía ampliada" : "Enlarged photograph"}
    >
      <button class="photo-close" autofocus>
        {lang === "es" ? "Cerrar" : "Close"} <span aria-hidden="true">×</span>
      </button>
      <img alt="" />
      <div class="photo-dialog-caption"></div>
    </dialog>
    <script>
      import "../scripts/editorial";
    </script>
    {production && <Analytics />}
  </body>
</html>
